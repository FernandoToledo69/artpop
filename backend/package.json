{
  "name": "artpop-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:recommendations": "node dist/recommendation-service/server.js",
    "benchmark:recommendations": "npm run prisma:generate && npm run build && node dist/scripts/benchmark-recommendations.js",
    "prisma:generate": "prisma generate --schema src/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "prisma:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "6.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx src/database/seed.ts"
  }
}
